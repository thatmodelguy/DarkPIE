//	firing controls
Mouse.rightbutton = KeepDown(Microphone.Said("right click"), .10)
Mouse.wheelup = KeepDown(Microphone.Said("zoom in"), .50)
Mouse.wheeldown = KeepDown(Microphone.Said("zoom out"), .50)
toggle(mouse.rightbutton)=said("hold right")
toggle(mouse.middlebutton)=said("orbit")
toggle(mouse.leftbutton)=said("hold left")

toggle(key.shift)=said("hold shift")or said("pan mode")
toggle(key.ctrl)=said("hold control")
toggle(key.alt)=said("hold alt")

if said("release")
mouse.LeftButton=0
mouse.rightbutton = 0
mouse.middlebutton = 0
key.shift = 0
ctrl=0
alt=0
end if
var.rate = 12 Hz
if KeepDown(Microphone.Said("scroll in"),1)
Mouse.wheelup = true
wait 0.20/var.rate
Mouse.wheelup = false
wait 0.20/var.rate
end if
var.rate = 12 Hz
if KeepDown(Microphone.Said("scroll out"),1)
Mouse.wheeldown = true
wait 0.20/var.rate
Mouse.wheeldown = false
wait 0.20/var.rate
end if
var.rate = 12 Hz
if KeepDown(Microphone.Said("fight"),1)
Mouse.LeftButton = true
wait 0.20/var.rate
Mouse.LeftButton = false
wait 0.20/var.rate
end if
