//      movement
if said("walk")
w=1
s=0
d=0
a=0
shift=0
endif
if said("Move left")
a=1
w=0
s=0
d=0
endif
if said("Move right")
d=1
a=0
s=0
w=0
endif
if said("go backward")
s=1
w=0
a=0
d=0
endif

if said("halt")
w=0 
s=0
a=0
d=0
shift=0
endif
if said("sprint")
shift=1
end if
Key.W = KeepDown(Microphone.Said("step foward"), .50)
//	menu controls
Key.Down = KeepDown(Microphone.Said("go down"), .10)
Key.Up = KeepDown(Microphone.Said("go up"), .10)
Key.Left = KeepDown(Microphone.Said("go left"), .10)
Key.Right = KeepDown(Microphone.Said("go right"), .10)
Key.Enter = KeepDown(Microphone.Said("enter"), .10)
Key.Esc = KeepDown(Microphone.Said("pause game"), .10)
Mouse.LeftButton = KeepDown(Microphone.Said("ok"), .10)
if said("Double click")
mouse.leftbutton = 1
wait .01
mouse.leftbutton = 0
wait .01
mouse.leftbutton = 1
wait .01
mouse.leftbutton = 0
end if
//	actions
Key.a = KeepDown(Microphone.Said("select all"), .10)
if said("add object")
shift=1
wait .30
a=1
wait .10
a=0
shift=0
end if
end if
